@startuml uml
skinparam classAttributeIconSize 0
skinparam style strictuml

' =========================
' APPLICATION LAYER
' =========================
class GameMaster {
    - batch : SpriteBatch
    - font : BitmapFont
    - shapes : ShapeRenderer
    - ctx : EngineContext
    + create() : void
    + render() : void
    + display() : void
}

' =========================
' ENGINE CORE
' =========================
class EngineContext {
    - config : EngineConfig
    - sceneManager : SceneManager
    - entityManager : EntityManager
    - movementManager : MovementManager
    - collisionManager : CollisionManager
    - ioManager :IOManager
    - renderQueue : RenderQueue
    - clock : EngineClock
    - collisionEvents : EventBus<CollisionEvent>
    + EngineContext()
    + update(realDt : float): void
    + dispose() : void
}

class EngineConfig {
    + width : int
    + height : int
    + title : String
    + vsync : boolean
    + targetFps : int
    + fixedDt : float
    + maxSubSteps : int
    + collisionCellSize : float
    + EngineConfig(width : int, height : int, title : String)
    + EngineConfig(width : int, height : int, title : String, vsync : boolean, targetFps : int, fixedDt : float, maxSubSteps : int, collisionCellSize : float)
}

GameMaster *-- EngineContext
EngineContext o-- EngineConfig
GameMaster ..> EngineConfig

EngineContext o-- EntityManager
EngineContext o-- SceneManager
EngineContext o-- MovementManager
EngineContext o-- CollisionManager
EngineContext o-- IOManager
EngineContext *-- RenderQueue
EngineContext *-- EngineClock
EngineContext *-- EventBus


' =========================
' ECS - ENTITY LAYER
' =========================
class Entity {
    - id : int
    - components : Map<Class, Component>
    + Entity(id : int)
    + getId() : int
    + viewComponents() : Map<Class, Component>
    + addComponent<T : Component>(type : Class<T>, component : T) : void
    + getComponent<T : Component>(type : Class<T>) : Class<T>
    + hasComponent<T : Component>(type : Class<T>) : boolean
    + removeComponent<T : Component>(type : Class<T>) : void
    + updateComponent<T : Component>(type : Class<T>, component : T) : void
    + toString() : String
}

class EntityManager {
    - idGen : EntityIdGenerator
    - entities : List<Entity>
    - pendingDestroyIds : Set<Integer>
    + EntityManager()
    + create() : Entity
    + destroy(e : Entity) : void
    + update(dt : float) : void
    + getAll() : List<Entity>
    + getEntity(id : int) : Entity
}

class EntityIdGenerator {
    - next : AtomicInteger
    + nextId() : int
}

EntityManager *-- EntityIdGenerator
EntityManager o-- Entity
Entity o-- Component

' =========================
' COMPONENTS
' =========================
interface Component

class TransformComponent {
    + x : float
    + y : float
    + rotation : float
}

class VelocityComponent {
    + vx : float
    + vy : float
}

class AccelerationComponent {
    + ax : float
    + ay : float
}

class ColliderComponent {
    + width : float
    + height : float
    + isStatic : boolean
}

class RenderableComponent {
    + shape : RenderShape
    + width : float
    + height : float
}

Component <|-- TransformComponent
Component <|-- VelocityComponent
Component <|-- AccelerationComponent
Component <|-- ColliderComponent
Component <|-- RenderableComponent


' =========================
' MOVEMENT SYSTEM
' =========================
class MovementManager {
    + update(deltaTime:float)
}

MovementManager --> EntityManager
MovementManager --> TransformComponent
MovementManager --> VelocityComponent
MovementManager --> AccelerationComponent
MovementManager --> EventBus


' =========================
' COLLISION SYSTEM
' =========================
interface CollisionManager {
    + detectCollisions()
    + resolveCollisions()
}

class SimpleCollisionManager {
    - spatialGrid : SpatialHashGrid
    + detectCollisions()
    + resolveCollisions()
}

class CollisionPair
class CollisionManifold
class CollisionResolver
class CollisionEvent

interface CollisionListener {
    + onCollision(event:CollisionEvent)
}

class SpatialHashGrid

CollisionManager <|-- SimpleCollisionManager
SimpleCollisionManager --> SpatialHashGrid
CollisionManager --> ColliderComponent
CollisionManager --> CollisionResolver
CollisionManager --> CollisionListener
CollisionManager --> CollisionEvent
CollisionResolver --> CollisionManifold
CollisionManifold --> CollisionPair
CollisionManager --> EventBus


' =========================
' RENDER SYSTEM
' =========================
class RenderQueue {
    - commands : List<RenderCommand>
    + submit(cmd:RenderCommand)
    + flush()
}

class RenderCommand {
    + x : float
    + y : float
    + width : float
    + height : float
    + shapeType : ShapeType
}

enum ShapeType {
    RECTANGLE
    CIRCLE
}

enum RenderShape {
    RECTANGLE
    CIRCLE
}

RenderQueue o-- RenderCommand
RenderableComponent --> RenderShape
RenderCommand --> ShapeType


' =========================
' SCENE MANAGEMENT
' =========================
interface Scene {
    + onEnter()
    + update()
    + onExit()
}

abstract class AbstractBaseScene {
    - context : EngineContext
}

class MenuScene
class SandboxScene
class TransitionScene

class SceneManager {
    - currentScene : Scene
    + changeScene(scene:Scene)
    + update()
}

Scene <|.. AbstractBaseScene
AbstractBaseScene <|-- MenuScene
AbstractBaseScene <|-- SandboxScene
AbstractBaseScene <|-- TransitionScene
SceneManager --> Scene
SceneManager --> EventBus


' =========================
' IO SYSTEM
' =========================
    
    ' ============= Enumerations =============
    enum InputAction {
        CONFIRM
        BACK
        PAUSE
        VOLUME_UP
        VOLUME_DOWN
        STOP
        PLAY
        SONG1
        SONG2
        SONG3
        MOVE_LEFT
        MOVE_RIGHT
        MOVE_UP
        MOVE_DOWN
        ACTION_1
        ACTION_2
    }
    
    ' ============= Input Classes =============
    class InputState {
        - currentState: EnumMap<InputAction, Boolean>
        - previousState: EnumMap<InputAction, Boolean>
        + InputState()
        + processInput(action: InputAction, isDown: boolean): void
        + nextFrame(): void
        + isPressed(a: InputAction): boolean
        + isJustPressed(a: InputAction): boolean
        + set(a: InputAction, isPressedNow: boolean, wasPressedLastFrame: boolean): void
    }
    
    class InputBinding {
        - keyToAction: Map<Integer, InputAction>
        + bind(keyCode: int, action: InputAction): void
        + unbind(keyCode: int): void
        + getAction(keyCode: int): InputAction
        + viewBindings(): Map<Integer, InputAction>
        + clear(): void
    }
    
    class InputHandler {
        - bindings: InputBinding
        - state: InputState
        + InputHandler(bindings: InputBinding)
        + update(deltaTime: float): void
        + getState(): InputState
        + setKeyState(keyCode: int, isPressed: boolean): void
        - isAnyKeyDownForAction(action: InputAction): boolean
    }
    
    ' ============= Audio Classes =============
    class Sound {
        - filePath: String
        - volume: float
        - playing: boolean
        - soundId: long
        - gdxSound: com.badlogic.gdx.audio.Sound
        + Sound(filePath: String)
        + getFilePath(): String
        + play(): void
        + stop(): void
        + setVolume(volume: float): void
        + getVolume(): float
        + isPlaying(): boolean
        + dispose(): void
    }
    
    class AudioPlayer {
        - masterVolume: float
        - currentMusic: Sound
        - lastMusicFilePath: String
        - activeSounds: List<Sound>
        + AudioPlayer()
        + getMasterVolume(): float
        + setMasterVolume(masterVolume: float): void
        + playMusic(filePath: String): void
        + getLastMusicFilePath(): String
        + playSound(filePath: String): void
        + stopMusic(): void
        + increaseVolume(amount: float): void
        + decreaseVolume(amount: float): void
        + getVolumePercentage(): int
        + getCurrentMusic(): Sound
        + dispose(): void
        - cleanupFinishedSounds(): void
    }
    
    ' ============= Logging Classes =============
    class ErrorEntry {
        - timestamp: long
        - tag: String
        - message: String
        + ErrorEntry(tag: String, message: String)
        + getTimestamp(): long
        + getTag(): String
        + getMessage(): String
        + formattedTimeStamp(): String
        + toString(): String
    }
    
    class ErrorLogger {
        - errorLogs: List<ErrorEntry>
        - maxErrors: int
        + ErrorLogger()
        + ErrorLogger(maxErrors: int)
        + log(tag: String, message: String): void
        + error(tag: String, message: String): void
        + error(tag: String, message: String, throwable: Throwable): void
        + getErrors(): List<ErrorEntry>
        + setMaxErrors(maxErrors: int): void
        + exportToFile(filePath: String): void
        - add(entry: ErrorEntry): void
    }
    
    ' ============= Output Classes =============
    class OutputHandler {
        - audioPlayer: AudioPlayer
        - errorLogger: ErrorLogger
        + OutputHandler(audioPlayer: AudioPlayer, errorLogger: ErrorLogger)
        + log(tag: String, message: String): void
        + error(tag: String, message: String): void
        + error(tag: String, message: String, throwable: Throwable): void
        + playMusic(filePath: String): void
        + playSound(filePath: String): void
        + stopMusic(): void
        + setVolume(volume: float): void
        + getAudioPlayer(): AudioPlayer
        + getErrorLogger(): ErrorLogger
        + dispose(): void
    }
    
    ' ============= Facade/Manager =============
    class IOManager {
        - inputHandler: InputHandler
        - outputHandler: OutputHandler
        + IOManager(inputHandler: InputHandler, outputHandler: OutputHandler)
        + getInputHandler(): InputHandler
        + getOutputHandler(): OutputHandler
        + update(deltaTime: float): void
        + log(tag: String, message: String): void
        + error(tag: String, message: String): void
        + error(tag: String, message: String, throwable: Throwable): void
        + playMusic(filePath: String): void
        + playSound(filePath: String): void
        + stopMusic(): void
        + dispose(): void
    }
    
    ' ============= Relationships =============
    
    ' InputHandler relationships
    InputHandler *-- InputBinding : "has"
    InputHandler *-- InputState : "has"
    InputHandler ..> InputAction : "uses"
    InputBinding ..> InputAction : "maps to"
    InputState ..> InputAction : "tracks"
    
    ' Audio relationships
    AudioPlayer o-- Sound : "contains current music"
    AudioPlayer o-- Sound : "contains active sounds"
    
    ' Logging relationships
    ErrorLogger o-- ErrorEntry : "contains"
    OutputHandler *-- AudioPlayer : "has"
    OutputHandler *-- ErrorLogger : "has"
    
    ' IOManager relationships (composition)
    IOManager *-- InputHandler : "owns"
    IOManager *-- OutputHandler : "owns"
    
    ' Method parameter/return type dependencies
    InputState --> InputAction : "uses as parameter"
    InputBinding --> InputAction : "uses as parameter"


' =========================
' UTILITIES
' =========================
class EngineClock {
    + deltaTime() : float
}

class EventBus {
    + publish(event:Object)
    + subscribe(listener:Object)
}

class Preconditions
class PairKey
class Mathf

@enduml