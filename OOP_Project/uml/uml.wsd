@startuml OOP_Project_Complete
skinparam classAttributeIconSize 0
skinparam style strictuml
skinparam backgroundColor #FEFEFE
skinparam arrowColor #333333

' =========================
' APPLICATION LAYER
' =========================

class GameMaster {
    - batch : SpriteBatch
    - font : BitmapFont
    - shapes : ShapeRenderer
    - ctx : EngineContext
    + create() : void
    + render() : void
    + display() : void
}

' =========================
' ENGINE PACKAGE
' =========================

package "engine" {
    ' =============================
    ' Core Engine Configuration
    ' =============================
    
    class EngineConfig {
        + width : int
        + height : int
        + title : String
        + vsync : boolean
        + targetFps : int
        + fixedDt : float
        + maxSubSteps : int
        + collisionCellSize : float
        + EngineConfig(width : int, height : int, title : String)
        + EngineConfig(width : int, height : int, title : String, vsync : boolean, targetFps : int, fixedDt : float, maxSubSteps : int, collisionCellSize : float)
    }

    class EngineContext {
        + config : EngineConfig
        + sceneManager : SceneManager
        + entityManager : EntityManager
        + movementManager : MovementManager
        + collisionManager : CollisionManager
        + ioManager : IOManager
        + renderer : IRenderer
        + clock : EngineClock
        + collisionEvents : EventBus<CollisionEvent>
        + EngineContext(config : EngineConfig, sceneManager : SceneManager, entityManager : EntityManager, movementManager : MovementManager, collisionManager : CollisionManager, ioManager : IOManager, renderer : IRenderer)
        + update(realDt : float) : void
        + dispose() : void
    }

    EngineContext --> EngineConfig : uses
    EngineContext --> SceneManager : manages
    EngineContext --> EntityManager : manages
    EngineContext --> MovementManager : uses
    EngineContext --> CollisionManager : uses
    EngineContext --> IOManager : uses
    EngineContext --> IRenderer : uses
    EngineContext --> EngineClock : uses
    EngineContext --> "EventBus<CollisionEvent>" : contains

    ' =============================
    ' Entity Package
    ' =============================
    
    package "entity" {
        class Entity {
            - id : int
            - components : Map<Class, Component>
            + Entity(id : int)
            + getId() : int
            + viewComponents() : Map<Class, Component>
            + addComponent<T : Component>(type : Class<T>, component : T) : void
            + getComponent<T : Component>(type : Class<T>) : Class<T>
            + hasComponent<T : Component>(type : Class<T>) : boolean
            + removeComponent<T : Component>(type : Class<T>) : void
            + updateComponent<T : Component>(type : Class<T>, component : T) : void
            + toString() : String

        }

        class EntityManager {
            - idGen : EntityIdGenerator
            - entities : List<Entity>
            - pendingDestroyIds : Set<Integer>
            + EntityManager()
            + create() : Entity
            + destroy(e : Entity) : void
            + update(dt : float) : void
            + getAll() : List<Entity>
            + getEntity(id : int) : Entity
        }

        class EntityIdGenerator {
            - next : AtomicInteger
            + nextId() : int
        }

        EntityManager --> EntityIdGenerator : uses
        EntityManager --> Entity : manages
        Entity --> Component : contains
    }

    ' =============================
    ' Components Package
    ' =============================
    
    package "components" {
        interface Component {
            {abstract} + validate() : void
        }
        
        class MissingComponentException {
            + MissingComponentException(message : String)
        }
    }

    ' =============================
    ' Movement Package
    ' =============================
    
    package "movement" {
        class TransformComponent {
            + x : float
            + y : float
            + rotationDeg : float
            + TransformComponent(x : float, y : float)
        }

        class VelocityComponent {
            + vx : float
            + vy : float
            + VelocityComponent(vx : float, vy : float)
        }

        class AccelerationComponent {
            + ax : float
            + ay : float
            + AccelerationComponent(ax : float, ay : float)
        }

        class MovementManager {
            - gravity : float
            - maxSpeed : float
            + MovementManager()
            + MovementManager(gravity : float, maxSpeed : float)
            + getGravity() : float
            + setGravity(gravity : float) : void
            + getMaxSpeed() : float
            + setMaxSpeed(maxSpeed : float) : void
            + update(dt : float, entities : Iterable<Entity>) : void
            + update(dt : float, entityManager : EntityManager) : void
            + moveEntity(dt : float, e : Entity) : void
            + movePhysics(dt : float, e : Entity, t : TransformComponent, v : VelocityComponent) : void
        }

        TransformComponent --|> Component
        VelocityComponent --|> Component
        AccelerationComponent --|> Component
        MovementManager --> Entity : updates
        MovementManager --> TransformComponent : uses
        MovementManager --> VelocityComponent : uses
        MovementManager --> AccelerationComponent : uses
    }

    ' =============================
    ' Collision Package
    ' =============================
    
    package "collision" {
        class ColliderComponent {
            + {static} enum ColShapeType
            + layer : int
            + mask : int
            + isTrigger : boolean
            + offsetX : float
            + offsetY : float
            + type : ColShapeType
            + radius : float
            + halfWidth : float
            + halfHeight : float
            - ColliderComponent(type : ColShapeType)
            + {static} circle(radius : float) : ColliderComponent
            + {static} aabb(halfWidth : float, halfHeight : float) : ColliderComponent
        }

        interface CollisionManager {
            {abstract} + update(dt : float, entities : Iterable<Entity>) : List<CollisionEvent>
        }

        class SimpleCollisionManager {
            - listeners : List<CollisionListener>
            - resolver : CollisionResolver
            - grid : SpatialHashGrid
            + SimpleCollisionManager()
            + SimpleCollisionManager(cellSize : float)
            + addListener(listener : CollisionListener) : void
            + setResolver(resolver : CollisionResolver) : void
            + update(dt : float, entities : Iterable<Entity>) : List<CollisionEvent>
            - passesFilter(a : ColliderComponent, b : ColliderComponent) : boolean
            - intersect(ta : TransformComponent, ca : ColliderComponent, tb : TransformComponent, cb : ColliderComponent) : CollisionManifold
        }

        class SpatialHashGrid {
            - cellSize : float
            - buckets : Map<Long, List<Entity>>
            + SpatialHashGrid(cellSize : float)
            + clear() : void
            + insert(e : Entity, t : TransformComponent, c : ColliderComponent) : void
            + computeCandidatePairs() : Set<PairKey>
            - worldToCell(v : float) : int
            - pack(x : int, y : int) : long
        }

        class CollisionEvent {
            - pair : CollisionPair
            - manifold : CollisionManifold
            + CollisionEvent(pair : CollisionPair, manifold : CollisionManifold)
            + getPair() : CollisionPair
            + getManifold() : CollisionManifold
        }

        class CollisionPair {
            - a : Entity
            - b : Entity
            + CollisionPair(a : Entity, b : Entity)
            + getA() : Entity
            + getB() : Entity
        }

        class CollisionManifold {
            + normalX : float
            + normalY : float
            + penetration : float
            + CollisionManifold(normalX : float, normalY : float, penetration : float)
        }

        interface CollisionListener {
            {abstract} + onCollision(event : CollisionEvent) : void
        }

        interface CollisionResolver {
            {abstract} + resolve(a : Entity, b : Entity, manifold : CollisionManifold) : void
        }

        ColliderComponent --|> Component
        SimpleCollisionManager --|> CollisionManager
        SimpleCollisionManager --> SpatialHashGrid : uses
        SimpleCollisionManager --> CollisionListener : notifies
        SimpleCollisionManager --> CollisionResolver : uses
        SimpleCollisionManager --> CollisionEvent : generates
        SpatialHashGrid --> Entity : contains
        SpatialHashGrid --> TransformComponent : uses
        SpatialHashGrid --> ColliderComponent : uses
        SpatialHashGrid --> "PairKey" : generates
        CollisionEvent --> CollisionPair : contains
        CollisionEvent --> CollisionManifold : contains
        CollisionPair --> Entity : references
        CollisionListener --> CollisionEvent : receives
        CollisionResolver --> Entity : resolves between
        CollisionResolver --> CollisionManifold : uses
    }

    ' =============================
    ' Scene Package
    ' =============================
    
    package "scene" {
        interface Scene {
            {abstract} + onLoad() : void
            {abstract} + onEnter() : void
            {abstract} + update(dt : float) : void
            {abstract} + onExit() : void
            {abstract} + onUnload() : void
            {abstract} + render() : void
            + name() : String
        }

        abstract class AbstractBaseScene {
            + onLoad() : void
            + onEnter() : void
            + onExit() : void
            + onUnload() : void
        }

        class SceneManager {
            - scenes : List<Scene>
            + SceneManager()
            + getScenes() : List<Scene>
            + current() : Scene
            + switchTo(scene : Scene) : void
            + push(scene : Scene) : void
            + pop() : void
            + size() : int
        }

        AbstractBaseScene --|> Scene
        SceneManager --> Scene : manages
    }

    ' =============================
    ' Render Package
    ' =============================
    
    package "render" {
        interface IRenderer {
            {abstract} + begin() : void
            {abstract} + end() : void
            {abstract} + draw(key : String, x : float, y : float, radius : float, width : float, height : float) : void
        }

        class RenderableComponent {
            + renderKey : String
            + RenderableComponent(key : String)
        }

        RenderableComponent --|> Component
        IRenderer --> RenderableComponent : uses
    }

    ' =============================
    ' IO Package
    ' =============================
    
    package "io" {
        enum InputAction {
            CONFIRM
            BACK 
            PAUSE
            VOLUME_UP 
            VOLUME_DOWN
            STOP
            PLAY
            SONG1
            SONG2
            SONG3
            MOVE_LEFT
            MOVE_RIGHT
            MOVE_UP
            MOVE_DOWN
            ACTION_1 
            ACTION_2
        }

        class InputBinding {
            - keyToAction : Map<Integer, InputAction>
            + InputBinding()
            + bind(keyCode : int, action : InputAction) : void
            + unbind(keyCode : int) : void
            + getAction(keyCode : int) : InputAction
            + viewBindings() : Map<Integer, InputAction>
            + clear() : void
        }

        class InputState {
            - currentState : EnumMap<InputAction, Boolean>
            - previousState : EnumMap<InputAction, Boolean>
            + InputState()
            + processInput(action : InputAction, isDown : boolean) : void
            + nextFrame() : void
            + isPressed(a : InputAction) : boolean
            + isJustPressed(a : InputAction) : boolean
            + set(a : InputAction, isPressedNow : boolean, wasPressedLastFrame : boolean) : void
        }

        class InputHandler {
            - bindings : InputBinding
            - state : InputState
            + InputHandler(bindings : InputBinding)
            + update(deltaTime : float) : void
            + getState() : InputState
            + setKeyState(keyCode : int, isPressed : boolean) : void
        }

        class AudioPlayer {
            - masterVolume : float
            - currentMusic : Sound
            - lastMusicFilePath : String
            - activeSounds : List<Sound>
            + AudioPlayer()
            + getMasterVolume() : float
            + setMasterVolume(masterVolume : float) : void
            + playMusic(filePath : String) : void
            + playSound(filePath : String) : void
            + getLastMusicFilePath() : String
            + stopMusic() : void
            + increaseVolume(amount : float) : void
            + decreaseVolume(amount : float) : void
            + getVolumePercentage() : int
            + getCurrentMusic() : Sound
            + dispose() : void
        }

        class Sound {
            - filePath : String
            - volume : float
            - playing : boolean
            - soundId : long
            - gdxSound : com.badlogic.gdx.audio.Sound
            + Sound(filePath : String)
            + getFilePath() : String
            + play() : void
            + stop() : void
            + setVolume(volume : float) : void
            + getVolume() : float
            + isPlaying() : boolean
            + dispose() : void
        }

        class ErrorLogger {
            - errorLogs : List<ErrorEntry>
            - maxErrors : int
            + ErrorLogger()
            + ErrorLogger(maxErrors : int)
            + log(tag : String, message : String) : void
            + error(tag : String, message : String) : void
            + error(tag : String, message : String, throwable : Throwable) : void
            - add(entry : ErrorEntry) : void
            + getErrors() : List<ErrorEntry>
            + setMaxErrors(maxErrors : int) : void
            + exportToFile(filePath : String) : void
        }

        class ErrorEntry {
            - timestamp : long
            - tag : String
            - message : String
            + ErrorEntry(tag : String, message : String)
            + getTimestamp() : long
            + getTag() : String
            + getMessage() : String
            + formattedTimeStamp() : String
            + toString() : String
        }

        class OutputHandler {
            - audioPlayer : AudioPlayer
            - errorLogger : ErrorLogger
            + OutputHandler(audioPlayer : AudioPlayer, errorLogger : ErrorLogger)
            + log(tag : String, message : String) : void
            + error(tag : String, message : String) : void
            + error(tag : String, message : String, throwable : Throwable) : void
            + playMusic(filePath : String) : void
            + playSound(filePath : String) : void
            + stopMusic() : void
            + setVolume(volume : float) : void
            + getAudioPlayer() : AudioPlayer
            + getErrorLogger() : ErrorLogger
            + dispose() : void
        }

        class IOManager {
            - inputHandler : InputHandler
            - outputHandler : OutputHandler
            + IOManager(inputHandler : InputHandler, outputHandler : OutputHandler)
            + getInputHandler() : InputHandler
            + getOutputHandler() : OutputHandler
            + update(deltaTime : float) : void
            + log(tag : String, message : String) : void
            + error(tag : String, message : String) : void
            + error(tag : String, message : String, throwable : Throwable) : void
            + playMusic(filePath : String) : void
            + playSound(filePath : String) : void
            + stopMusic() : void
            + dispose() : void
        }

        InputHandler --> InputBinding : uses
        InputHandler --> InputState : uses
        InputState --> InputAction : uses
        AudioPlayer --> Sound : manages
        OutputHandler --> AudioPlayer : uses
        OutputHandler --> ErrorLogger : uses
        OutputHandler --> Sound : uses
        ErrorLogger --> ErrorEntry : contains
        IOManager --> InputHandler : delegates to
        IOManager --> OutputHandler : delegates to
    }

    ' =============================
    ' Util Package
    ' =============================
    
    package "util" {
        class EngineClock {
            - fixedDt : float
            - accumulator : float
            - paused : boolean
            - stepRequested : boolean
            + EngineClock(fixedDt : float)
            + togglePause() : void
            + isPaused() : boolean
            + requestStep() : void
            + consumeSteps(realDt : float, maxSteps : int) : int
            + fixedDt() : float
        }

        class "EventBus<T>" {
            - listeners : List<Consumer<T>>
            + EventBus()
            + subscribe(listener : Consumer<T>) : void
            + publish(event : T) : void
            + listenerCount() : int
        }

        class PairKey {
            + a : int
            + b : int
            + PairKey(id1 : int, id2 : int)
            + equals(o : Object) : boolean
            + hashCode() : int
        }

        class Mathf {
            + {static} clamp(v : float, min : float, max : float) : float
            + {static} length(x : float, y : float) : float
            + {static} length2(x : float, y : float) : float
            + {static} distance(ax : float, ay : float, bx : float, by : float) : float
            + {static} distance2(ax : float, ay : float, bx : float, by : float) : float
        }

        class Preconditions {
            + {static} notNull<T>(value : T, name : String) : T
            + {static} check(condition : boolean, message : String) : void
        }
    }
}

' =========================
' DEMO PACKAGE
' =========================

package "demo" {
    ' =============================
    ' Demo Render Package
    ' =============================
    
    package "render" {
        class LibGdxRenderer {
            - shapes : ShapeRenderer
            - drawers : Map<String, ShapeDrawer>
            + LibGdxRenderer(shapes : ShapeRenderer)
            - initDrawers() : void
            + begin() : void
            + end() : void
            + draw(key : String, x : float, y : float, radius : float, w : float, h : float) : void
        }

        interface ShapeDrawer {
            {abstract} + draw(x : float, y : float, radius : float, w : float, h : float) : void
        }

        LibGdxRenderer --|> IRenderer
        LibGdxRenderer --> ShapeDrawer : uses
    }

    ' =============================
    ' Demo Scene Package
    ' =============================
    
    package "scenes" {
        class MenuScene {
            - ctx : EngineContext
            - spawnCount : int
            + MenuScene(ctx : EngineContext)
            + onLoad() : void
            + update(dt : float) : void
            + render() : void
            + getSpawnCount() : int
        }

        class SandboxScene {
            - ctx : EngineContext
            - initialSpawnCount : int
            - player : Entity
            - npc : Entity
            - rng : Random
            - npcHitCooldown : float
            + SandboxScene(ctx : EngineContext, initialSpawnCount : int)
            + onLoad() : void
            + update(dt : float) : void
            + render() : void
            - onCollision(event : CollisionEvent) : void
            - spawnObstacle(x : float, y : float) : void
            - keepInsideWindowBounce(e : Entity) : void
            - isPair(a : Entity, b : Entity, x : Entity, y : Entity) : boolean
        }

        class TransitionScene {
            - ctx : EngineContext
            - next : Scene
            - duration : float
            - t : float
            + TransitionScene(ctx : EngineContext, next : Scene, durationSeconds : float)
            + onLoad() : void
            + update(dt : float) : void
            + render() : void
        }

        MenuScene --|> AbstractBaseScene
        SandboxScene --|> AbstractBaseScene
        TransitionScene --|> AbstractBaseScene
        MenuScene --> EngineContext : uses
        SandboxScene --> EngineContext : uses
        SandboxScene --> Entity : manages
        SandboxScene --> CollisionEvent : listens to
        TransitionScene --> EngineContext : uses
        TransitionScene --> Scene : wraps
    }
}

' =============================
' DEMO TEST PACKAGE
' =============================

class EngineSmokeTest {
    + {static} main(args : String[]) : void
}

EngineSmokeTest --> EntityManager : uses
EngineSmokeTest --> Entity : creates
EngineSmokeTest --> MovementManager : uses
EngineSmokeTest --> SimpleCollisionManager : uses
EngineSmokeTest --> TransformComponent : uses
EngineSmokeTest --> VelocityComponent : uses
EngineSmokeTest --> ColliderComponent : uses

' =============================
' KEY RELATIONSHIPS
' =============================

GameMaster --> EngineContext : creates and uses
GameMaster --> LibGdxRenderer : creates
GameMaster --> MenuScene : creates
EngineContext --> IRenderer : uses (polymorphic)
MenuScene --> SandboxScene : transitions to
MenuScene --> TransitionScene : wraps with
SandboxScene --> Entity : manages
SandboxScene ..|> CollisionListener : implements

@enduml